/-
  Finite function-free data objects used by Scherer's function-removal map.

  This module is deliberately semantic and independent of comparison,
  selection, traces, and function-removal syntax. `dataTy` is connected
  directly to the public finite-set interpretation `SemObj`.
-/

import Gimbal.FiniteSemantics
import Mathlib.Data.Fintype.BigOperators

namespace Gimbal.Equality.Scherer

/-! ### Function-free data objects -/

/-- Objects generated by zero, one, products, and sums only. -/
inductive DataObj where
  | zero
  | one
  | prod (left right : DataObj)
  | sum (left right : DataObj)
  deriving DecidableEq, Repr

namespace DataObj

/-- The ordinary Gimbal object represented by a data object. -/
def erase {n : Nat} : DataObj → Object n
  | .zero => .never
  | .one => .unit
  | .prod A B => .prod A.erase B.erase
  | .sum A B => .coprod A.erase B.erase

/-- A compact sum-of-units representation of a finite set of size `n`. -/
def enum : Nat → DataObj
  | 0 => .zero
  | 1 => .one
  | n + 2 => .sum .one (enum (n + 1))

/-- Eliminate a function whose domain is already function-free. -/
def dataArr : DataObj → DataObj → DataObj
  | .zero, _ => .one
  | .one, B => B
  | .prod A B, C => dataArr A (dataArr B C)
  | .sum A B, C => .prod (dataArr A C) (dataArr B C)

/-- Eliminate atoms and arrows from a Gimbal object. -/
def dataTy {n : Nat} (card : Fin n → Nat) : Object n → DataObj
  | .base q => enum (card q)
  | .unit => .one
  | .never => .zero
  | .prod A B => .prod (dataTy card A) (dataTy card B)
  | .coprod A B => .sum (dataTy card A) (dataTy card B)
  | .exp A B => dataArr (dataTy card A) (dataTy card B)

/-! ### Executable values -/

/-- Set-theoretic values of a function-free data object. -/
@[reducible] def Val : DataObj → Type
  | .zero => Empty
  | .one => PUnit
  | .prod A B => Val A × Val B
  | .sum A B => Sum (Val A) (Val B)

mutual
  /-- Every data object has a finite value type. -/
  @[reducible] def Val.fintype : (A : DataObj) → Fintype A.Val
    | .zero => inferInstance
    | .one => inferInstance
    | .prod A B => by
        letI : Fintype A.Val := Val.fintype A
        letI : Fintype B.Val := Val.fintype B
        exact inferInstance
    | .sum A B => by
        letI : Fintype A.Val := Val.fintype A
        letI : Fintype B.Val := Val.fintype B
        exact inferInstance

  /-- Equality of data values is decidable. -/
  @[reducible] def Val.decidableEq : (A : DataObj) → DecidableEq A.Val
    | .zero => inferInstance
    | .one => inferInstance
    | .prod A B => by
        letI : DecidableEq A.Val := Val.decidableEq A
        letI : DecidableEq B.Val := Val.decidableEq B
        exact inferInstance
    | .sum A B => by
        letI : DecidableEq A.Val := Val.decidableEq A
        letI : DecidableEq B.Val := Val.decidableEq B
        exact inferInstance
end

instance (A : DataObj) : Fintype A.Val := Val.fintype A
instance (A : DataObj) : DecidableEq A.Val := Val.decidableEq A

/-! ### Finite enumeration -/

/-- `enum n` is executable and contains exactly the values `Fin n`. -/
def enumEquiv : (n : Nat) → Fin n ≃ (enum n).Val
  | 0 =>
      { toFun := fun x => nomatch x
        invFun := fun x => nomatch x
        left_inv := fun x => nomatch x
        right_inv := fun x => nomatch x }
  | 1 =>
      { toFun := fun _ => PUnit.unit
        invFun := fun _ => 0
        left_inv := by intro x; exact (Fin.eq_zero x).symm
        right_inv := by intro x; cases x; rfl }
  | n + 2 =>
      { toFun := Fin.cases (Sum.inl PUnit.unit)
          (fun i => Sum.inr (enumEquiv (n + 1) i))
        invFun := fun x => match x with
          | .inl _ => 0
          | .inr i => (enumEquiv (n + 1)).symm i |>.succ
        left_inv := by
          intro i
          refine Fin.cases ?_ (fun j => ?_) i
          · rfl
          · simp
        right_inv := by
          intro x
          cases x with
          | inl u => cases u; rfl
          | inr i => simp }

@[simp] theorem enumEquiv_apply_symm_apply {n : Nat} (x : (enum n).Val) :
    enumEquiv n ((enumEquiv n).symm x) = x :=
  (enumEquiv n).apply_symm_apply x

@[simp] theorem enumEquiv_symm_apply_apply {n : Nat} (i : Fin n) :
    (enumEquiv n).symm (enumEquiv n i) = i :=
  (enumEquiv n).symm_apply_apply i

/-! ### Arrow elimination equivalence -/

/-- Functions out of a data object are represented by a data object. -/
def dataArrEquiv : (A B : DataObj) → (A.Val → B.Val) ≃ (dataArr A B).Val
  | .zero, B =>
      { toFun := fun _ => PUnit.unit
        invFun := fun _ x => nomatch x
        left_inv := by intro f; funext x; exact nomatch x
        right_inv := by intro x; cases x; rfl }
  | .one, B => Equiv.funUnique PUnit B.Val
  | .prod A B, C =>
      (Equiv.curry A.Val B.Val C.Val).trans <|
        (Equiv.arrowCongr (Equiv.refl A.Val) (dataArrEquiv B C)).trans <|
          dataArrEquiv A (dataArr B C)
  | .sum A B, C =>
      (Equiv.sumArrowEquivProdArrow A.Val B.Val C.Val).trans <|
        Equiv.prodCongr (dataArrEquiv A C) (dataArrEquiv B C)

@[simp] theorem dataArrEquiv_apply_symm_apply {A B : DataObj}
    (x : (dataArr A B).Val) :
    dataArrEquiv A B ((dataArrEquiv A B).symm x) = x :=
  (dataArrEquiv A B).apply_symm_apply x

@[simp] theorem dataArrEquiv_symm_apply_apply {A B : DataObj}
    (f : A.Val → B.Val) :
    (dataArrEquiv A B).symm (dataArrEquiv A B f) = f :=
  (dataArrEquiv A B).symm_apply_apply f

/-! ### Agreement with public finite semantics -/

/-- `dataTy` is isomorphic to the existing public finite interpretation. -/
def dataTyEquiv {n : Nat} (card : Fin n → Nat) :
    (A : Object n) → SemObj card A ≃ (dataTy card A).Val
  | .base q => enumEquiv (card q)
  | .unit => Equiv.refl PUnit
  | .never => Equiv.refl Empty
  | .prod A B => Equiv.prodCongr (dataTyEquiv card A) (dataTyEquiv card B)
  | .coprod A B => Equiv.sumCongr (dataTyEquiv card A) (dataTyEquiv card B)
  | .exp A B =>
      (Equiv.arrowCongr (dataTyEquiv card A) (dataTyEquiv card B)).trans
        (dataArrEquiv (dataTy card A) (dataTy card B))

@[simp] theorem dataTyEquiv_apply_symm_apply {n : Nat}
    (card : Fin n → Nat) {A : Object n} (x : (dataTy card A).Val) :
    dataTyEquiv card A ((dataTyEquiv card A).symm x) = x :=
  (dataTyEquiv card A).apply_symm_apply x

@[simp] theorem dataTyEquiv_symm_apply_apply {n : Nat}
    (card : Fin n → Nat) {A : Object n} (x : SemObj card A) :
    (dataTyEquiv card A).symm (dataTyEquiv card A x) = x :=
  (dataTyEquiv card A).symm_apply_apply x

/-! ### Cardinalities -/

@[simp] theorem card_enum (n : Nat) :
    Fintype.card (enum n).Val = n := by
  simpa using (Fintype.card_congr (enumEquiv n)).symm

@[simp] theorem card_dataArr (A B : DataObj) :
    Fintype.card (dataArr A B).Val = Fintype.card B.Val ^ Fintype.card A.Val := by
  have h := Fintype.card_congr (dataArrEquiv A B)
  simpa using h.symm

theorem card_dataTy {n : Nat} (card : Fin n → Nat) (A : Object n) :
    letI := SemObj.fintype card A
    Fintype.card (dataTy card A).Val = Fintype.card (SemObj card A) := by
  letI := SemObj.fintype card A
  exact (Fintype.card_congr (dataTyEquiv card A)).symm

/-! ### Boundary fixtures -/

namespace Fixtures

abbrev sig1 : Signature := ⟨1, #[]⟩
def q : Fin sig1.nBases := ⟨0, by decide⟩
abbrev Q : Object sig1.nBases := .base q

def deadCard : Fin sig1.nBases → Nat := fun _ => 0
def liveCard : Fin sig1.nBases → Nat := fun _ => 1

theorem dead_q : dataTy deadCard Q = .zero := rfl

theorem dead_q_to_zero :
    dataTy deadCard (.exp Q .never) = .one := rfl

theorem live_q_to_zero :
    dataTy liveCard (.exp Q .never) = .zero := rfl

theorem live_not_q_to_zero :
    dataTy liveCard (.exp (.exp Q .never) .never) = .one := rfl

theorem unit_domain {B : DataObj} (f : PUnit → B.Val) :
    dataArrEquiv .one B f = f PUnit.unit := rfl

theorem zero_domain {B : DataObj} (f : Empty → B.Val) :
    dataArrEquiv .zero B f = PUnit.unit := rfl

theorem product_domain_curry {B : DataObj}
    (f : (PUnit × PUnit) → B.Val) :
    dataArrEquiv (.prod .one .one) B f = f (PUnit.unit, PUnit.unit) := rfl

theorem sum_domain_split {B : DataObj}
    (f : Sum PUnit PUnit → B.Val) :
    dataArrEquiv (.sum .one .one) B f =
      (f (.inl PUnit.unit), f (.inr PUnit.unit)) := rfl

end Fixtures

end DataObj

end Gimbal.Equality.Scherer
