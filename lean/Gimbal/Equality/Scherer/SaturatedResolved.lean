/-
  Intrinsic resolved dependency support for saturated Scherer syntax.

  Unlike raw support, resolved support is not popped by a store: the stored
  variable inherits the support annotation carried by the pending head.  The
  `PendingDeps` index makes those annotations occurrence-sensitive.
-/

import Gimbal.Equality.Scherer.ResolvedRealize

namespace Gimbal.Equality.Scherer

variable {sig : Signature}

/-! ### Resolved pending annotations -/

/-- One resolved dependency support for every pending occurrence. -/
inductive PendingDeps (O : Type) : Pending sig → Type where
  | empty : PendingDeps O .empty
  | cons {P ps} : DepSupport O → PendingDeps O ps → PendingDeps O (.cons P ps)

namespace PendingDeps

variable {O : Type}

def toList : {ps : Pending sig} → PendingDeps O ps → List (DepSupport O)
  | .empty, .empty => []
  | .cons _ _, .cons K rest => K :: rest.toList

def union [DecidableEq O] : {ps : Pending sig} → PendingDeps O ps → DepSupport O
  | .empty, .empty => ∅
  | .cons _ _, .cons K rest => K ∪ rest.union

@[simp] theorem toList_empty :
    toList (.empty : PendingDeps O (.empty : Pending sig)) = [] := rfl

@[simp] theorem toList_cons {P : Pos sig.nBases} {ps : Pending sig}
    (K : DepSupport O) (rest : PendingDeps O ps) :
    toList (.cons (P := P) K rest) = K :: rest.toList := rfl

@[simp] theorem union_empty [DecidableEq O] :
    union (.empty : PendingDeps O (.empty : Pending sig)) = ∅ := rfl

@[simp] theorem union_cons [DecidableEq O]
    {P : Pos sig.nBases} {ps : Pending sig}
    (K : DepSupport O) (rest : PendingDeps O ps) :
    union (.cons (P := P) K rest) = K ∪ rest.union := rfl

/-- Forget universe membership while retaining exact pending order/supports. -/
def ofResolvedPending {U : SearchUniverse sig} :
    (rps : ResolvedPending U O) → PendingDeps O rps.erase
  | [] => .empty
  | c :: rest => .cons c.support (ofResolvedPending rest)

@[simp] theorem toList_ofResolvedPending {U : SearchUniverse sig}
    (rps : ResolvedPending U O) :
    (ofResolvedPending rps).toList = rps.map (·.support) := by
  induction rps with
  | nil => rfl
  | cons c rest ih => simp [ofResolvedPending, ih]

end PendingDeps

/-! ### Intrinsic resolved support -/

mutual

/-- Resolved support of a saturated negative neutral. -/
def SNegNeu.resolvedSupport {O : Type} [DecidableEq O]
    {Γ : StableCtx sig} (env : ResolvedEnv Γ O) {N : Neg sig.nBases} :
    SNegNeu Γ N → DepSupport O
  | .var x => env _ x
  | .fst n => n.resolvedSupport env
  | .snd n => n.resolvedSupport env
  | .app n p => n.resolvedSupport env ∪ p.resolvedSupport env

/-- Resolved support of a saturated positive neutral. -/
def SPosNeu.resolvedSupport {O : Type} [DecidableEq O]
    {Γ : StableCtx sig} (env : ResolvedEnv Γ O) {P : Pos sig.nBases} :
    SPosNeu Γ P → DepSupport O
  | .atom x => env _ x
  | .inl p => p.resolvedSupport env
  | .inr p => p.resolvedSupport env
  | .shift t =>
      t.resolvedSupport (Old := Γ) (New := .empty) env .empty

/-- Exact pending supports generated by the observations, in occurrence order. -/
def NonemptyBatchObs.resolvedPending {O : Type} [DecidableEq O]
    {Γ : StableCtx sig} (env : ResolvedEnv Γ O) {ps : Pending sig} :
    NonemptyBatchObs Γ ps → PendingDeps O ps
  | .one n => .cons (n.resolvedSupport env) .empty
  | .cons n rest => .cons (n.resolvedSupport env) (rest.resolvedPending env)

/-- Union of resolved supports of all observation occurrences. -/
def NonemptyBatchObs.resolvedSupport {O : Type} [DecidableEq O]
    {Γ : StableCtx sig} (env : ResolvedEnv Γ O) {ps : Pending sig} :
    NonemptyBatchObs Γ ps → DepSupport O
  | .one n => n.resolvedSupport env
  | .cons n rest => n.resolvedSupport env ∪ rest.resolvedSupport env

/-- Resolved support of saturation, including observations and batch body. -/
def Sat.resolvedSupport {O : Type} [DecidableEq O]
    {Old New : StableCtx sig} (env : ResolvedEnv (Old.append New) O)
    {P : Pos sig.nBases} : Sat Old New P → DepSupport O
  | .inconsistent z => z.resolvedSupport env
  | .done v => v.resolvedSupport env
  | .batch obs body =>
      obs.resolvedSupport env ∪
        body.resolvedSupport (Old := Old.append New) (New := .empty)
          env (obs.resolvedPending env)

/--
Resolved support under an occurrence-annotated pending telescope.  Store
extends by the pending-head support and deliberately does not pop that support.
-/
def SInv.resolvedSupport {O : Type} [DecidableEq O]
    {Old New : StableCtx sig} (env : ResolvedEnv (Old.append New) O) :
    {ps : Pending sig} → (ann : PendingDeps O ps) →
      {G : Goal sig.nBases} → SInv Old New ps G → DepSupport O
  | _, .empty, _, .unit => ∅
  | _, .empty, _, .pair l r =>
      l.resolvedSupport env .empty ∪ r.resolvedSupport env .empty
  | _, .empty, _, .lam t =>
      t.resolvedSupport env (.cons ∅ .empty)
  | _, .empty, _, .satShift s => s.resolvedSupport env
  | _, .empty, _, .satPos s => s.resolvedSupport env
  | _, .cons K rest, _, .caseSum l r =>
      l.resolvedSupport env (.cons K rest) ∪
        r.resolvedSupport env (.cons K rest)
  | _, .cons _ _, _, .abort => ∅
  | _, .cons K rest, _, .storeAtom (q := q) t =>
      t.resolvedSupport (Old := Old) (New := New.snoc (.atom q))
        (ResolvedEnv.extend env K) rest
  | _, .cons K rest, _, .storeShift (N := N) t =>
      t.resolvedSupport (Old := Old) (New := New.snoc (.neg N))
        (ResolvedEnv.extend env K) rest

end


/-! ### Graph relations and determinacy -/

def SNegResolved {O : Type} [DecidableEq O] {Γ : StableCtx sig}
    (env : ResolvedEnv Γ O) {N} (n : SNegNeu Γ N) (K : DepSupport O) : Prop :=
  n.resolvedSupport env = K

def SPosResolved {O : Type} [DecidableEq O] {Γ : StableCtx sig}
    (env : ResolvedEnv Γ O) {P} (p : SPosNeu Γ P) (K : DepSupport O) : Prop :=
  p.resolvedSupport env = K

def BatchResolved {O : Type} [DecidableEq O] {Γ : StableCtx sig}
    (env : ResolvedEnv Γ O) {ps} (obs : NonemptyBatchObs Γ ps)
    (ann : PendingDeps O ps) (K : DepSupport O) : Prop :=
  obs.resolvedPending env = ann ∧ obs.resolvedSupport env = K

def SatResolved {O : Type} [DecidableEq O] {Old New : StableCtx sig}
    (env : ResolvedEnv (Old.append New) O) {P} (s : Sat Old New P)
    (K : DepSupport O) : Prop := s.resolvedSupport env = K

def SInvResolved {O : Type} [DecidableEq O] {Old New : StableCtx sig}
    (env : ResolvedEnv (Old.append New) O) {ps} (ann : PendingDeps O ps)
    {G} (t : SInv Old New ps G) (K : DepSupport O) : Prop :=
  t.resolvedSupport env ann = K

theorem SNegResolved.unique {O : Type} [DecidableEq O] {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} {N} {n : SNegNeu Γ N} {K K' : DepSupport O}
    (h : SNegResolved env n K) (h' : SNegResolved env n K') : K = K' :=
  h.symm.trans h'

theorem SPosResolved.unique {O : Type} [DecidableEq O] {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} {P} {p : SPosNeu Γ P} {K K' : DepSupport O}
    (h : SPosResolved env p K) (h' : SPosResolved env p K') : K = K' :=
  h.symm.trans h'

theorem BatchResolved.unique {O : Type} [DecidableEq O] {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} {ps} {obs : NonemptyBatchObs Γ ps}
    {ann ann' : PendingDeps O ps} {K K' : DepSupport O}
    (h : BatchResolved env obs ann K)
    (h' : BatchResolved env obs ann' K') : ann = ann' ∧ K = K' :=
  ⟨h.1.symm.trans h'.1, h.2.symm.trans h'.2⟩

theorem SatResolved.unique {O : Type} [DecidableEq O]
    {Old New : StableCtx sig} {env : ResolvedEnv (Old.append New) O}
    {P} {s : Sat Old New P} {K K' : DepSupport O}
    (h : SatResolved env s K) (h' : SatResolved env s K') : K = K' :=
  h.symm.trans h'

theorem SInvResolved.unique {O : Type} [DecidableEq O]
    {Old New : StableCtx sig} {env : ResolvedEnv (Old.append New) O}
    {ps} {ann : PendingDeps O ps} {G} {t : SInv Old New ps G}
    {K K' : DepSupport O}
    (h : SInvResolved env ann t K) (h' : SInvResolved env ann t K') : K = K' :=
  h.symm.trans h'


/-! ### Abstract raw support interpreted at a realized context -/

namespace CtxRealizes

variable {U : SearchUniverse sig} {O : Type} {B : Nat}

/-- Interpret exact state levels as intrinsic stable levels. -/
def liftRaw {st : ResolvedState U O B} {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} (h : CtxRealizes st Γ env)
    (K : RawFactSupport st) : RawSupport Γ :=
  K.map ⟨h.toLevel, by
    intro i j hij
    apply Fin.ext
    exact congrArg (fun x : StableLevel Γ => x.val) hij⟩

@[simp] theorem mem_liftRaw {st : ResolvedState U O B} {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} (h : CtxRealizes st Γ env)
    (K : RawFactSupport st) (i : Fin st.depth) :
    h.toLevel i ∈ h.liftRaw K ↔ i ∈ K := by
  constructor
  · intro hi
    obtain ⟨j, hj, heq⟩ := Finset.mem_map.mp hi
    have : j = i := by
      apply Fin.ext
      exact congrArg (fun x : StableLevel Γ => x.val) heq
    simpa [this] using hj
  · intro hi
    exact Finset.mem_map.mpr ⟨i, hi, rfl⟩

@[simp] theorem liftRaw_empty {st : ResolvedState U O B} {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} (h : CtxRealizes st Γ env) :
    h.liftRaw (∅ : RawFactSupport st) = ∅ := by
  simp [liftRaw]

@[simp] theorem liftRaw_singleton {st : ResolvedState U O B} {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} (h : CtxRealizes st Γ env) (i : Fin st.depth) :
    h.liftRaw ({i} : RawFactSupport st) = {h.toLevel i} := by
  simp [liftRaw]

@[simp] theorem liftRaw_union {st : ResolvedState U O B} {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} (h : CtxRealizes st Γ env)
    (K L : RawFactSupport st) :
    h.liftRaw (K ∪ L) = h.liftRaw K ∪ h.liftRaw L := by
  simp [liftRaw, Finset.map_union]

/-- At a fixed realized depth, intrinsic lifting loses no level information. -/
theorem liftRaw_injective {st : ResolvedState U O B} {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} (h : CtxRealizes st Γ env) :
    Function.Injective h.liftRaw := by
  intro K L heq
  ext i
  rw [← mem_liftRaw h K i, ← mem_liftRaw h L i, heq]

/-- Lifting changes the Fin bound, never its depth-erased level values. -/
theorem rawVals_liftRaw {st : ResolvedState U O B} {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} (h : CtxRealizes st Γ env)
    (K : RawFactSupport st) :
    (h.liftRaw K).image Fin.val = rawVals K := by
  simp only [liftRaw, rawVals]
  ext n
  simp [toLevel]

/-- `resetRound` does not change the interpretation of raw levels. -/
theorem liftRaw_resetRound {st : ResolvedState U O B} {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} (h : CtxRealizes st Γ env)
    (K : RawFactSupport st) :
    h.resetRound.liftRaw K = h.liftRaw K := by
  ext i
  simp only [liftRaw, Finset.mem_map]
  constructor <;> rintro ⟨j, hj, heq⟩ <;>
    exact ⟨j, hj, Fin.ext (congrArg Fin.val heq)⟩

/-- Old abstract levels map to weakened intrinsic levels after a push. -/
theorem liftRaw_push_old
    {st : ResolvedState U O B} {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} (h : CtxRealizes st Γ env)
    {S : UStable U} {Knew : DepSupport O} {hd : st.depth < B}
    (hP : CtxRealizes (st.push hd S Knew) (Γ.snoc S.val)
      (ResolvedEnv.extend env Knew))
    (K : RawFactSupport st) :
    hP.liftRaw (K.map ⟨Fin.castSucc, Fin.castSucc_injective _⟩) =
      wkSupport (S := S.val) (h.liftRaw K) := by
  apply Finset.image_injective (fun i j hij => Fin.ext hij)
  ext n
  simp [liftRaw, wkSupport, wkLevel, toLevel]

/-- Popping an old-only pushed support recovers its original interpretation. -/
theorem pop_liftRaw_push_old
    {st : ResolvedState U O B} {Γ : StableCtx sig}
    {env : ResolvedEnv Γ O} (h : CtxRealizes st Γ env)
    {S : UStable U} {Knew : DepSupport O} {hd : st.depth < B}
    (hP : CtxRealizes (st.push hd S Knew) (Γ.snoc S.val)
      (ResolvedEnv.extend env Knew))
    (K : RawFactSupport st) :
    popSupport (S := S.val)
        (hP.liftRaw (K.map ⟨Fin.castSucc, Fin.castSucc_injective _⟩)) =
      h.liftRaw K := by
  rw [liftRaw_push_old h hP K, pop_wkSupport]

end CtxRealizes

end Gimbal.Equality.Scherer
