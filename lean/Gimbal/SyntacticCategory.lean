/-
  Syntactic category `CΣ`: objects wrapped by signature, morphisms modulo `DefEq`.

  Uses Lean's `Quotient` on each hom-set. Does **not** use Mathlib's
  `CategoryTheory.Quotient`, which requires an existing `Category` instance.

  Note: Lean reserves `Σ` as a binder token, so the type is the escaped
  identifier `«CΣ»` (same mathematical name as in the design docs).
-/

import Mathlib.CategoryTheory.Category.Basic
import Gimbal.DefinitionalEquality

namespace Gimbal

namespace DefEq

theorem equivalence {sig : Signature} {A B : Object sig.nBases} :
    Equivalence (@DefEq sig A B) where
  refl := refl
  symm := symm
  trans := trans

end DefEq

/-- Explicit setoid for definitional equality (avoid a global `Setoid` instance). -/
def defEqSetoid {sig : Signature} (A B : Object sig.nBases) : Setoid (Morphism sig A B) where
  r := DefEq
  iseqv := DefEq.equivalence

/-- An object of the syntactic category generated by `sig`. -/
structure «CΣ» (sig : Signature) where
  asObject : Object sig.nBases
  deriving DecidableEq, Repr

namespace «CΣ»

variable {sig : Signature}

/-- Morphisms of `«CΣ»` are checked morphisms modulo `DefEq`. -/
def Hom (A B : «CΣ» sig) : Type :=
  Quotient (defEqSetoid A.asObject B.asObject)

/-- Quote a checked morphism into the quotient hom-set. -/
def Hom.mk {A B : «CΣ» sig} (f : Morphism sig A.asObject B.asObject) : Hom A B :=
  Quotient.mk (defEqSetoid A.asObject B.asObject) f

theorem Hom.mk_eq_mk_iff {A B : «CΣ» sig}
    (f g : Morphism sig A.asObject B.asObject) :
    Hom.mk f = Hom.mk g ↔ DefEq f g := by
  change Quotient.mk _ f = Quotient.mk _ g ↔ DefEq f g
  exact Quotient.eq

def Hom.id (A : «CΣ» sig) : Hom A A :=
  Hom.mk (Morphism.id A.asObject)

def Hom.comp {A B C : «CΣ» sig} (f : Hom A B) (g : Hom B C) : Hom A C :=
  Quotient.liftOn₂ f g (fun f g => Hom.mk (f.compose g))
    (by
      intro f₁ g₁ f₂ g₂ hf hg
      exact Quotient.sound (DefEq.cong_compose hf hg))

@[simp]
theorem Hom.comp_mk {A B C : «CΣ» sig}
    (f : Morphism sig A.asObject B.asObject)
    (g : Morphism sig B.asObject C.asObject) :
    Hom.comp (Hom.mk f) (Hom.mk g) = Hom.mk (f.compose g) :=
  rfl

theorem Hom.id_comp {A B : «CΣ» sig} (f : Hom A B) : Hom.comp (Hom.id A) f = f := by
  refine Quotient.inductionOn f ?_
  intro f
  exact Quotient.sound (DefEq.id_left f)

theorem Hom.comp_id {A B : «CΣ» sig} (f : Hom A B) : Hom.comp f (Hom.id B) = f := by
  refine Quotient.inductionOn f ?_
  intro f
  exact Quotient.sound (DefEq.id_right f)

theorem Hom.assoc {A B C D : «CΣ» sig} (f : Hom A B) (g : Hom B C) (h : Hom C D) :
    Hom.comp (Hom.comp f g) h = Hom.comp f (Hom.comp g h) := by
  refine Quotient.inductionOn₃ f g h ?_
  intro f g h
  exact Quotient.sound (DefEq.assoc f g h)

end «CΣ»

instance (sig : Signature) : CategoryTheory.Category («CΣ» sig) where
  Hom := «CΣ».Hom
  id := «CΣ».Hom.id
  comp := «CΣ».Hom.comp
  id_comp := «CΣ».Hom.id_comp
  comp_id := «CΣ».Hom.comp_id
  assoc := «CΣ».Hom.assoc

end Gimbal
